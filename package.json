{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "supabase:update": "brew upgrade supabase",
    "supabase:gen-types": "dotenv -e .env.local -- bash -c 'supabase gen types --lang typescript --project-id $SUPABASE_PROJECT_ID --schema public > ./src/types/supabase.ts'",
